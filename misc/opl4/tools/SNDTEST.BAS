10 ' SNDTEST - prueba de sonido ZEMMIX (PSG, click, OPLL, OPL3, SCC, PCM, OPL4 y mezcla)
20 CLEAR 200,&HC800:DEFINT A-Z:SCREEN 0:WIDTH 40:KEY OFF:COLOR 15,4,4
30 RESTORE 9000:A=&HC800
40 READ H$:IF H$="*" THEN 60
50 POKE A,VAL("&H"+H$):A=A+1:GOTO 40
60 DEFUSR0=&HC810:DEFUSR1=&HC840:DEFUSR2=&HC850:DEFUSR3=&HC890
70 X=USR3(0):X=PEEK(&HC807):P$="desconocido ("+HEX$(X)+"h)"
80 IF X=15 THEN P$="AY-3-8910" ELSE IF X=255 THEN P$="YM2149"
90 CLS:PRINT"Buscando el SCC...":GOSUB 1200:TB=0
100 CLS:PRINT"ZEMMIX - PRUEBA DE SONIDO":PRINT
110 PRINT"PSG: ";P$
120 IF SC<0 THEN PRINT"SCC: no encontrado" ELSE PRINT"SCC: slot";SC AND 3;"-";(SC\4) AND 3
130 PRINT:PRINT" 1 PSG: niveles y canales"
140 PRINT" 2 PSG: ruido"
150 PRINT" 3 PSG: envolventes"
160 PRINT" 4 Click de teclado"
170 PRINT" 5 OPLL (MSX-MUSIC)"
180 PRINT" 6 OPL3 (activar con Bloq Despl)"
190 PRINT" 7 SCC"
200 PRINT" 8 PCM turboR"
210 PRINT" 9 Todo junto (mezcla)"
215 PRINT" A OPL4 (MoonSound)"
220 PRINT" 0 Todas las pruebas en orden"
230 PRINT" Q Salir"
240 K$=INKEY$:IF K$="" THEN 240
250 K=INSTR("123456789Aa",K$):IF K THEN ON K GOSUB 2000,2100,2200,2300,2400,2600,2800,3000,3200,3400,3400:GOSUB 800:GOTO 100
260 IF K$="0" THEN FOR Z=1 TO 10:ON Z GOSUB 2000,2100,2200,2300,2400,2600,2800,3000,3200,3400:GOSUB 800:NEXT:GOTO 100
270 IF K$="Q" OR K$="q" THEN GOSUB 800:CLS:END
280 GOTO 240
800 ' silencio
810 SOUND 7,&HBF:SOUND 8,0:SOUND 9,0:SOUND 10,0
820 FOR R=&H20 TO &H28:V=0:GOSUB 950:NEXT
830 FOR R=&HB0 TO &HB8:V=0:GOSUB 960:NEXT
840 IF SC>=0 THEN SA=&H988F:V=0:GOSUB 1000
845 FOR R=&HB0 TO &HB8:V=0:GOSUB 970:NEXT:FOR W=&H68 TO &H7F:V=0:GOSUB 980:NEXT
850 RETURN
900 ' espera D cuadros
910 T!=TIME
920 U!=TIME-T!:IF U!<0 THEN U!=U!+65536!
930 IF U!<D THEN 920
940 RETURN
950 OUT &H7C,R:OUT &H7D,V:RETURN
960 OUT &HC0,R:OUT &HC1,V:RETURN
970 OUT &HC6,R:OUT &HC7,V:RETURN
980 OUT &H7E,W:OUT &H7F,V:RETURN
1000 ' escribe V en SA del slot SS
1010 POKE &HCA00,V AND 255:POKE &HC803,1:POKE &HC804,0
1020 POKE &HC800,SS:POKE &HC801,SA AND 255:POKE &HC802,((SA AND &HFF00)\256) AND 255
1030 POKE &HC805,0:POKE &HC806,&HCA:X=USR0(0):RETURN
1050 ' escribe 32 bytes de CA00h en SA del slot SS
1060 POKE &HC803,32:POKE &HC804,0:GOTO 1020
1100 ' lee V de SA del slot SS
1110 POKE &HC800,SS:POKE &HC801,SA AND 255:POKE &HC802,((SA AND &HFF00)\256) AND 255
1120 X=USR1(0):V=PEEK(&HC807):RETURN
1200 ' busca el SCC en los slots 1 y 2: onda de prueba en 9800h tras 9000h=3Fh
1210 SC=-1:SV=PEEK(&HF343)
1220 FOR P=1 TO 2:E=PEEK(&HFCC1+P) AND 128:FOR S=0 TO 3*(E\128)
1230 SS=P OR E OR S*4:IF SS=SV OR SC>=0 THEN 1260
1240 SA=&H9000:V=&H3F:GOSUB 1000:SA=&H9800:V=&H5A:GOSUB 1000:GOSUB 1100:IF V<>&H5A THEN 1260
1250 V=&HA5:GOSUB 1000:GOSUB 1100:IF V=&HA5 THEN SC=SS
1260 NEXT S,P:SS=SC:RETURN
1300 ' tabla PCM: 8 periodos de seno en 256 muestras (490 Hz a 15.7 kHz)
1310 IF TB THEN RETURN
1320 PRINT"(calculando la tabla...)"
1330 FOR I=0 TO 255:POKE &HC900+I,127+INT(126*SIN(I*.1963495)):NEXT:TB=1:RETURN
2000 CLS:PRINT"PSG: canal A a 440 Hz, nivel 0 a 15":PRINT"(cada paso unos 3 dB)"
2010 SOUND 0,254:SOUND 1,0:SOUND 2,202:SOUND 3,0:SOUND 4,170:SOUND 5,0:SOUND 7,&HBE
2020 FOR L=0 TO 15:LOCATE 0,3:PRINT"nivel";L;" ":SOUND 8,L:D=25:GOSUB 900:NEXT:SOUND 8,0
2030 PRINT:PRINT"Canales A, B y C por separado (nivel 15)"
2040 FOR C=0 TO 2:LOCATE 0,6:PRINT"canal ";CHR$(65+C):SOUND 7,&HBF XOR 2^C:SOUND 8+C,15:D=50:GOSUB 900:SOUND 8+C,0:NEXT
2050 PRINT:PRINT"A+B+C juntos (acorde La mayor)"
2060 SOUND 7,&HB8:SOUND 8,15:SOUND 9,15:SOUND 10,15:D=120:GOSUB 900:RETURN
2100 CLS:PRINT"PSG: ruido en el canal A":PRINT"(periodo 0 a 31)"
2110 SOUND 7,&HB7:SOUND 8,15
2120 FOR N=0 TO 31:LOCATE 0,3:PRINT"periodo";N;" ":SOUND 6,N:D=10:GOSUB 900:NEXT
2130 PRINT:PRINT"Tono + ruido en el canal A"
2140 SOUND 0,254:SOUND 1,0:SOUND 6,8:SOUND 7,&HB6:D=90:GOSUB 900:RETURN
2200 CLS:PRINT"PSG: envolventes":PRINT"(AY: 16 pasos, YM: 32 mas suaves)"
2210 PRINT:PRINT"Rampa lenta de subida (forma 13)":PRINT"se oyen los escalones"
2220 SOUND 0,127:SOUND 1,0:SOUND 7,&HBE:SOUND 8,16:SOUND 11,0:SOUND 12,100:SOUND 13,13:D=270:GOSUB 900
2230 PRINT"Rampa lenta de bajada (forma 9)":SOUND 13,9:D=270:GOSUB 900
2240 PRINT:PRINT"Envolvente como onda (sin tono):"
2250 SOUND 7,&HBF:SOUND 11,12:SOUND 12,0
2260 RESTORE 9500:FOR J=1 TO 4:READ N,N$:LOCATE 0,10:PRINT"forma";N;N$;SPACE$(20-LEN(N$)):SOUND 13,N:D=90:GOSUB 900:NEXT
2270 PRINT"Formas de un solo golpe, lentas:"
2280 SOUND 7,&HBE:SOUND 11,0:SOUND 12,12
2290 FOR J=1 TO 4:READ N,N$:LOCATE 0,12:PRINT"forma";N;N$;SPACE$(20-LEN(N$)):SOUND 13,N:D=60:GOSUB 900:NEXT:RETURN
2300 CLS:PRINT"Click de teclado (PPI puerto AAh bit 7)"
2310 PRINT:PRINT"Zumbido":FOR I=1 TO 600:OUT &HAA,INP(&HAA) XOR 128:NEXT
2320 PRINT"Clicks sueltos":FOR J=1 TO 10:OUT &HAA,INP(&HAA) XOR 128:D=12:GOSUB 900:NEXT:RETURN
2400 CLS:PRINT"OPLL (puertos 7Ch/7Dh)":PRINT"(si no suena: slot 0 no esta en modo":PRINT" primario o MSX-MUSIC no habilitado)"
2410 R=&H0E:V=0:GOSUB 950:R=&H30:V=&H30:GOSUB 950
2420 PRINT:PRINT"Escala con el instrumento 3 (piano)"
2430 RESTORE 9600:FOR J=1 TO 8:READ F,B:R=&H10:V=F AND 255:GOSUB 950:R=&H20:V=16+B*2+F\256:GOSUB 950:D=20:GOSUB 900:V=V-16:GOSUB 950:NEXT
2440 PRINT"Instrumentos 1 a 15 (La 440 Hz)"
2450 FOR I=1 TO 15:LOCATE 0,8:PRINT"instrumento";I;" ":R=&H30:V=I*16:GOSUB 950
2460 R=&H10:V=288 AND 255:GOSUB 950:R=&H20:V=16+8+1:GOSUB 950:D=40:GOSUB 900:V=V-16:GOSUB 950:D=5:GOSUB 900:NEXT:RETURN
2600 CLS:PRINT"OPL3 (puertos C0h/C1h, modo OPL2)":PRINT"(si no suena: activar con Bloq Despl)"
2610 RESTORE 9700:FOR J=1 TO 12:READ R,V:GOSUB 960:NEXT
2620 PRINT:PRINT"Escala, onda seno con algo de FM"
2630 RESTORE 9750:FOR J=1 TO 8:READ F,B:R=&HA0:V=F AND 255:GOSUB 960:R=&HB0:V=32+B*4+F\256:GOSUB 960:D=20:GOSUB 900:V=V-32:GOSUB 960:NEXT:RETURN
2800 CLS:PRINT"SCC"
2810 IF SC<0 THEN PRINT:PRINT"No hay SCC en los slots 1 o 2":D=120:GOSUB 900:RETURN
2820 GOSUB 2900
2830 PRINT:PRINT"Escala en el canal 1 (onda seno)"
2840 SA=&H988A:V=15:GOSUB 1000:SA=&H988F:V=1:GOSUB 1000
2850 RESTORE 9800:FOR J=1 TO 8:READ N:SA=&H9880:V=N AND 255:GOSUB 1000:SA=&H9881:V=N\256:GOSUB 1000:D=20:GOSUB 900:NEXT
2860 PRINT"Canal 2 (onda cuadrada), La 440 Hz"
2870 SA=&H988F:V=0:GOSUB 1000:SA=&H9882:V=253:GOSUB 1000:SA=&H9883:V=0:GOSUB 1000
2880 SA=&H988B:V=15:GOSUB 1000:SA=&H988F:V=2:GOSUB 1000:D=60:GOSUB 900:RETURN
2900 ' ondas del SCC: canal 1 seno, canal 2 cuadrada
2910 SA=&H9000:V=&H3F:GOSUB 1000
2920 FOR I=0 TO 31:POKE &HCA00+I,INT(127*SIN(I*.1963495)) AND 255:NEXT:SA=&H9800:GOSUB 1050
2930 FOR I=0 TO 31:POKE &HCA00+I,&H7F-(I>15) AND 255:NEXT:SA=&H9820:GOSUB 1050:RETURN
3000 CLS:PRINT"PCM turboR (puertos A4h/A5h)":PRINT"Seno de 490 Hz durante 2 s":GOSUB 1300
3010 GOSUB 3100:RETURN
3100 ' toca 31400 muestras (2 s) de la tabla C900h
3110 POKE &HC805,0:POKE &HC806,&HC9:POKE &HC803,&HA8:POKE &HC804,&H7A:X=USR2(0):RETURN
3200 CLS:PRINT"Todo junto: cada fuente a tope,":PRINT"entrando una a una":PRINT:GOSUB 1300
3210 PRINT"PSG  La4 (440 Hz)":SOUND 0,254:SOUND 1,0:SOUND 7,&HBE:SOUND 8,15:D=40:GOSUB 900
3220 IF SC<0 THEN 3240
3230 PRINT"SCC  Do#5 (554 Hz)":GOSUB 2900:SA=&H9880:V=201:GOSUB 1000:SA=&H9881:V=0:GOSUB 1000:SA=&H988A:V=15:GOSUB 1000:SA=&H988F:V=1:GOSUB 1000:D=40:GOSUB 900
3240 PRINT"OPLL Mi5 (659 Hz)":R=&H30:V=&H80:GOSUB 950:R=&H10:V=216:GOSUB 950:R=&H20:V=16+10:GOSUB 950:D=40:GOSUB 900
3250 PRINT"OPL3 La5 (880 Hz)":RESTORE 9700:FOR J=1 TO 12:READ R,V:GOSUB 960:NEXT:R=&HA0:V=580 AND 255:GOSUB 960:R=&HB0:V=32+20+2:GOSUB 960:D=40:GOSUB 900
3260 PRINT"PCM  490 Hz (2 s)":GOSUB 3100
3270 PRINT"Click":FOR I=1 TO 300:OUT &HAA,INP(&HAA) XOR 128:NEXT
3280 D=60:GOSUB 900:RETURN
3400 CLS:PRINT"OPL4 / MoonSound":PRINT"FM en C4h-C7h, wave en 7Eh/7Fh":PRINT"(FM: activar con Bloq Despl)"
3410 R=5:V=3:GOSUB 970:' banco 1 reg 05h: NEW (OPL3) + NEW2 (wave)
3420 W=2:OUT &H7E,W:I=INP(&H7F):PRINT:PRINT"ID wave (reg 02h): ";HEX$(I);" (2x = OPL4)"
3430 PRINT:PRINT"FM banco 1 (solo OPL3/OPL4): escala"
3440 RESTORE 9700:FOR J=1 TO 12:READ R,V:GOSUB 970:NEXT
3450 RESTORE 9750:FOR J=1 TO 8:READ F,B:R=&HA0:V=F AND 255:GOSUB 970:R=&HB0:V=32+B*4+F\256:GOSUB 970:D=20:GOSUB 900:V=V-32:GOSUB 970:NEXT
3460 W=2:V=1:GOSUB 980:' acceso a la memoria de ondas
3470 PRINT:PRINT"Memoria de ondas (SRAM 3FFF00h): ";
3480 W=3:V=&H3F:GOSUB 980:W=4:V=&HFF:GOSUB 980:W=5:V=0:GOSUB 980:OUT &H7E,6:FOR I=0 TO 15:OUT &H7F,I*17:NEXT
3490 W=5:V=0:GOSUB 980:OUT &H7E,6:E=0:FOR I=0 TO 15:IF INP(&H7F)<>I*17 THEN E=E+1
3500 NEXT:IF E THEN PRINT E;"errores" ELSE PRINT"bien"
3510 W=3:V=0:GOSUB 980:W=4:V=0:GOSUB 980:W=5:V=0:GOSUB 980:OUT &H7E,6:A$=""
3520 FOR I=0 TO 3:A$=A$+RIGHT$("0"+HEX$(INP(&H7F)),2)+" ":NEXT
3530 PRINT"ROM 000000h: ";A$:PRINT"(40 18 00 00 = YRW801 cargada)"
3540 W=2:V=0:GOSUB 980
3550 PRINT:PRINT"Wavetable: tonos de la ROM, slot 0":PRINT"(sin el motor PCM no suena)"
3560 RESTORE 9900:FOR J=1 TO 6:READ T:LOCATE 0,17:PRINT"tono";T;" "
3570 W=&H50:V=0:GOSUB 980:W=&H20:V=(T\256) AND 1:GOSUB 980:W=&H08:V=T AND 255:GOSUB 980:W=&H38:V=0:GOSUB 980
3580 W=&H68:V=&H80:GOSUB 980:D=60:GOSUB 900:V=0:GOSUB 980:D=10:GOSUB 900:NEXT:RETURN
