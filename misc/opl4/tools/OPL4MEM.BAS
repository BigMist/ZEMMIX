10 REM OPL4 wave memory test (ZEMMIX), ports C6h/C7h and 7Eh/7Fh (Bloq Despl on)
15 OUT &HC6,5:OUT &HC7,3:OUT &H7E,2:OUT &H7F,1:REM NEW2 + memory access
20 OUT &H7E,2:I=INP(&H7F):PRINT "ID ";HEX$(I);" (2x = ok)"
30 E=0:PRINT "Writing (SRAM 200000h-3FFFFFh)..."
40 FOR B=32 TO 63 STEP 4:GOSUB 200
50 OUT &H7E,6:FOR I=0 TO 255:OUT &H7F,(I XOR B*3) AND 255:NEXT I
60 NEXT B:PRINT "Reading..."
70 FOR B=32 TO 63 STEP 4:GOSUB 200
80 OUT &H7E,6:FOR I=0 TO 255:V=INP(&H7F)
90 IF V<>((I XOR B*3) AND 255) THEN E=E+1:IF E<10 THEN PRINT "bad ";HEX$(B);":";HEX$(I);" ";HEX$(V)
100 NEXT I:NEXT B
110 PRINT "Status ";INP(&H7E)
115 OUT &H7E,2:OUT &H7F,0
120 PRINT "Errors:";E;"of 2048":END
200 OUT &H7E,3:OUT &H7F,B:OUT &H7E,4:OUT &H7F,B*4 AND 255:OUT &H7E,5:OUT &H7F,0:RETURN
