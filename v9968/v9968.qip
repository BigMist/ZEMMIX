# V9968 (HRA!) as the ZEMMIX VDP (entity vdp), from the V9968 cartridge (TangNano20K) sources.
# rtl/: V9968 core files unchanged except v9968_core.v (vdp.v renamed, upscan / video_out removed).
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) rtl/v9968_core.v]
